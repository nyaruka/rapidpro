msgstr "el UUID único de este mensaje"

msgid "the quick replies for this message, formatted according to send method and content type"
msgstr "las respuestas rápidas para este mensaje, formateadas según el método de envío y el tipo de contenido"

msgid "the channel UUID"
msgstr "el UUID del canal"

